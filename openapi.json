{
  "openapi": "3.1.0",
  "info": {
    "title": "SAVER Verifier",
    "version": "1.1.1",
    "description": "Independently check externally sourced factual claims in agent research and reports. Returns supported, contradicted, mixed or insufficient_evidence with web sources. Use when a claim needs a cited second check; not for transaction simulation, wallet risk or deterministic arithmetic. Live verification costs 0.20 USDC on Base via x402 v2."
  },
  "servers": [
    {
      "url": "https://api.saververify.com"
    }
  ],
  "paths": {
    "/verify": {
      "post": {
        "operationId": "verifyClaim",
        "summary": "Check an external factual claim with web evidence",
        "description": "Independently check externally sourced factual claims in agent research and reports. Returns supported, contradicted, mixed or insufficient_evidence with web sources. Use when a claim needs a cited second check; not for transaction simulation, wallet risk or deterministic arithmetic. Live verification costs 0.20 USDC on Base via x402 v2. This endpoint keeps the original response shape; use /v2/verify for explicit evidence-to-source links.",
        "security": [
          {
            "x402": []
          }
        ],
        "x-payment-info": {
          "protocols": "x402",
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.20"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000,
                    "pattern": "\\S",
                    "description": "Claim or factual statement to verify"
                  },
                  "context": {
                    "type": "string",
                    "maxLength": 12000,
                    "description": "Optional additional context"
                  }
                },
                "required": [
                  "claim"
                ],
                "additionalProperties": false
              },
              "example": {
                "claim": "IRENA's Renewable Capacity Statistics 2024 shows that renewables generated 86% of global electricity in 2023.",
                "context": "An energy-sector briefing cites https://www.irena.org/News/pressreleases/2024/Mar/Record-Growth-in-Renewables-but-Progress-Needs-to-be-Equitable . Independently check the attributed statistic against the original publication, including the year, measured quantity and denominator."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            },
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded x402 settlement response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Read base64-encoded PaymentRequired JSON in PAYMENT-REQUIRED. Body may be {}. An authorized x402 v2 wallet client retries the same body with PAYMENT-SIGNATURE.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "Request payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Verification service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Verification timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Claim verification"
        ]
      }
    },
    "/v2/verify": {
      "post": {
        "operationId": "verifyClaimWithSources",
        "summary": "Verify a claim with explicit evidence-to-source links",
        "description": "Independently check externally sourced factual claims in agent research and reports. Returns supported, contradicted, mixed or insufficient_evidence with web sources. Use when a claim needs a cited second check; not for transaction simulation, wallet risk or deterministic arithmetic. Live verification costs 0.20 USDC on Base via x402 v2. Evidence references source IDs. URLs are checked against search metadata, but this is not proof that each interpretation is correct. Confidence is model-assessed.",
        "security": [
          {
            "x402": []
          }
        ],
        "x-payment-info": {
          "protocols": "x402",
          "price": {
            "mode": "fixed",
            "currency": "USDC",
            "amount": "0.20"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claim": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000,
                    "pattern": "\\S",
                    "description": "Claim or factual statement to verify"
                  },
                  "context": {
                    "type": "string",
                    "maxLength": 12000,
                    "description": "Optional additional context"
                  }
                },
                "required": [
                  "claim"
                ],
                "additionalProperties": false
              },
              "example": {
                "claim": "IRENA's Renewable Capacity Statistics 2024 shows that renewables generated 86% of global electricity in 2023.",
                "context": "An energy-sector briefing cites https://www.irena.org/News/pressreleases/2024/Mar/Record-Growth-in-Renewables-but-Progress-Needs-to-be-Equitable . Independently check the attributed statistic against the original publication, including the year, measured quantity and denominator."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponseV2"
                },
                "example": {
                  "schemaVersion": "2.0",
                  "requestId": "saver-professional-example-20261018-energy-capacity-check",
                  "status": "contradicted",
                  "confidence": 0.98,
                  "explanation": "The attributed statistic is misread. IRENA's Renewable Capacity Statistics 2024 is a capacity publication, and its 86% figure refers to renewables' share of global power capacity additions in 2023, not electricity generated. The same IRENA publication says renewables were 43%/43.2% of global installed power capacity at the end of 2023. IRENA's separate Renewable Energy Statistics 2024 treats electricity production in GWh and its world renewable electricity production share table runs through 2022, showing 29.1% in 2022 rather than any 86% generation figure for 2023. Independent global electricity-generation sources report about 30% renewable generation in 2023, not 86%.",
                  "domain": "general-verification",
                  "timestamp": "2026-10-18T14:25:57.697Z",
                  "confidenceType": "model_assessed",
                  "evidence": [
                    {
                      "id": "e1",
                      "text": "IRENA's Renewable Capacity Statistics 2024 foreword says the publication illustrates growth in new installed power generation capacity in 2023; it states that by the end of 2023 renewables accounted for 43% of global installed power capacity, and that the 86% figure was renewables' share of global power additions after adding 473 GW of renewable capacity.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s1"
                      ]
                    },
                    {
                      "id": "e2",
                      "text": "The IRENA press release cited in the briefing likewise says Renewable Capacity Statistics 2024 showed total renewable capacity of 3,870 GW globally in 2023 and that renewables accounted for 86% of capacity additions; it does not describe the 86% as electricity generated.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s2"
                      ]
                    },
                    {
                      "id": "e3",
                      "text": "In Renewable Capacity Statistics 2024, IRENA's table for 'Renewable energy share of electricity capacity' lists the World row as 43.2% for 2023, confirming the publication is reporting installed electricity capacity shares, not generated electricity shares.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s1"
                      ]
                    },
                    {
                      "id": "e4",
                      "text": "IRENA's separate Renewable Energy Statistics 2024 explains that generation data are presented in GWh and includes an indicator for 'Renewable energy share of electricity production.' Its world production-share table covers 2014-2022 and reports 29.1% for 2022, not an 86% global generation share for 2023.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s3"
                      ]
                    },
                    {
                      "id": "e5",
                      "text": "Ember's Global Electricity Review 2024 reports that renewables reached 30% of global electricity generation in 2023; it further breaks out hydro at 14%, wind at 7.8%, solar at 5.5%, bioenergy at 2.4%, and other renewables at 0.3%.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s4"
                      ]
                    },
                    {
                      "id": "e6",
                      "text": "Our World in Data, using Ember's final 2023 global electricity generation data, says renewables produced just over 30% of the world's electricity in 2023.",
                      "relation": "contradicts",
                      "sourceIds": [
                        "s5"
                      ]
                    }
                  ],
                  "sources": [
                    {
                      "id": "s1",
                      "title": "irena.org",
                      "url": "https://www.irena.org/-/media/Files/IRENA/Agency/Publication/2024/Mar/IRENA_RE_Capacity_Statistics_2024.pdf?rev=a587503ac9a2435c8d13e40081d2ec34"
                    },
                    {
                      "id": "s2",
                      "title": "irena.org",
                      "url": "https://www.irena.org/News/pressreleases/2024/Mar/Record-Growth-in-Renewables-but-Progress-Needs-to-be-Equitable"
                    },
                    {
                      "id": "s3",
                      "title": "irena.org",
                      "url": "https://www.irena.org/-/media/Files/IRENA/Agency/Publication/2024/Jul/IRENA_Renewable_Energy_Statistics_2024.pdf"
                    },
                    {
                      "id": "s4",
                      "title": "ember-energy.org",
                      "url": "https://ember-energy.org/latest-insights/global-electricity-review-2024/global-electricity-trends"
                    },
                    {
                      "id": "s5",
                      "title": "ourworldindata.org",
                      "url": "https://ourworldindata.org/data-insights/renewable-electricity-2023"
                    }
                  ]
                }
              }
            },
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded x402 settlement response.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Read base64-encoded PaymentRequired JSON in PAYMENT-REQUIRED. Body may be {}. An authorized x402 v2 wallet client retries the same body with PAYMENT-SIGNATURE.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "description": "Request payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Verification service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Verification timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Claim verification"
        ]
      }
    },
    "/examples.json": {
      "get": {
        "operationId": "readVerificationExamples",
        "summary": "Read published paid verification examples for free; no new verification is run",
        "responses": {
          "200": {
            "description": "Actual operator-funded paid results with provenance and payment references."
          }
        }
      }
    },
    "/agent-tool.json": {
      "get": {
        "operationId": "readAgentToolDefinition",
        "summary": "Read the flat input schema and canonical endpoint for agents",
        "responses": {
          "200": {
            "description": "Agent integration metadata; not a payment challenge."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VerificationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "mixed",
              "insufficient_evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Model-assessed confidence; not a calibrated probability or independent accuracy guarantee."
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "domain": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "confidence",
          "explanation",
          "evidence",
          "sources",
          "domain",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message",
          "requestId"
        ],
        "additionalProperties": false
      },
      "VerificationResponseV2": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "supported",
              "contradicted",
              "mixed",
              "insufficient_evidence"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "explanation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "supports",
                    "contradicts",
                    "context"
                  ]
                },
                "sourceIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "text",
                "relation",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "domain": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "schemaVersion": {
            "type": "string",
            "const": "2.0"
          },
          "requestId": {
            "type": "string"
          },
          "confidenceType": {
            "type": "string",
            "const": "model_assessed"
          }
        },
        "required": [
          "status",
          "confidence",
          "explanation",
          "evidence",
          "sources",
          "domain",
          "timestamp",
          "schemaVersion",
          "requestId",
          "confidenceType"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 payment authorization. Unpaid requests receive HTTP 402 with Payment-Required metadata."
      }
    }
  },
