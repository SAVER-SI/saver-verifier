{
  "name": "saver_verify_claim",
  "description": "Independently check externally sourced factual claims in agent research and reports. Returns supported, contradicted, mixed or insufficient_evidence with web sources. Use when a claim needs a cited second check; not for transaction simulation, wallet risk or deterministic arithmetic. Live verification costs 0.20 USDC on Base via x402 v2.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "claim": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000,
        "pattern": "\\S",
        "description": "Claim or factual statement to verify"
      },
      "context": {
        "type": "string",
        "maxLength": 12000,
        "description": "Optional additional context"
      }
    },
    "required": [
      "claim"
    ],
    "additionalProperties": false
  },
  "transport": {
    "type": "http",
    "method": "POST",
    "url": "https://api.saververify.com/v2/verify",
    "bodyMapping": "Send inputSchema fields as the JSON body directly. Do not send this transport object, a body wrapper, method, type or bodyType as body fields.",
    "contentType": "application/json"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "supported",
          "contradicted",
          "mixed",
          "insufficient_evidence"
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "explanation": {
        "type": "string"
      },
      "evidence": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "relation": {
              "type": "string",
              "enum": [
                "supports",
                "contradicts",
                "context"
              ]
            },
            "sourceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "text",
            "relation",
            "sourceIds"
          ],
          "additionalProperties": false
        }
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "id",
            "title",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "domain": {
        "type": "string"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "schemaVersion": {
        "type": "string",
        "const": "2.0"
      },
      "requestId": {
        "type": "string"
      },
      "confidenceType": {
        "type": "string",
        "const": "model_assessed"
      }
    },
    "required": [
      "status",
      "confidence",
      "explanation",
      "evidence",
      "sources",
      "domain",
      "timestamp",
      "schemaVersion",
      "requestId",
      "confidenceType"
    ],
    "additionalProperties": false
  },
  "payment": {
    "protocol": "x402",
    "version": 2,
    "scheme": "exact",
    "network": "eip155:8453",
    "currency": "USDC",
    "price": "0.20",
    "challengeHeader": "PAYMENT-REQUIRED",
    "authorizationHeader": "PAYMENT-SIGNATURE",
    "receiptHeader": "PAYMENT-RESPONSE",
    "policy": "Use an existing authorized x402 wallet under a bounded spending policy. Do not request or expose private keys."
  },
  "examples": "https://api.saververify.com/examples.json",
  "openapi": "https://api.saververify.com/openapi.json",
  "limitations": [
    "Confidence is model-assessed, not calibrated.",
    "Source-link checks do not establish correctness of interpretation.",
    "An insufficient_evidence result is a completed paid verification.",
    "No idempotency or result-recovery endpoint is currently offered."
  ],
  "requestRecovery": {
    "validation": "HTTP 400/413 responses include code and help. Correct the content type or JSON using help; validation happens before payment.",
    "method": "GET/HEAD return 405 with Allow: POST. HEAD has no body; GET includes JSON guidance. OPTIONS returns 200.",
    "retry": "Use help.endpoint to preserve the original response version. Only sign after receiving and validating a 402 challenge under the existing spending policy.",
    "health": "https://api.saververify.com/healthz"
  }
}
